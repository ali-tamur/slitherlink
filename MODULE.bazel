module(
    name = "slitherlink",
    version = "0.1",
)

bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "rules_cc", version = "0.2.26")
bazel_dep(name = "abseil-cpp", version = "20260817.0")
bazel_dep(name = "googletest", version = "1.18.0.bcr.1")

# C++ toolchain: LLVM 23.1.3, downloaded by Bazel so the build works on any machine.
bazel_dep(name = "toolchains_llvm", version = "1.11.3")

llvm = use_extension("@toolchains_llvm//toolchain/extensions:llvm.bzl", "llvm")
llvm.toolchain(llvm_version = "23.1.3")
use_repo(llvm, "llvm_toolchain")

register_toolchains("@llvm_toolchain//:all")
